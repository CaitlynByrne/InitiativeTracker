{
  "name": "initiative-tracker-dm-console",
  "version": "1.0.0",
  "description": "DM Console for Initiative Tracker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:docker": "docker-compose -f ../../infrastructure/docker-compose.test.yml run --rm dm-console-test npm test",
    "test:docker:watch": "docker-compose -f ../../infrastructure/docker-compose.test.yml run --rm dm-console-test npm run test:unit",
    "test:docker:coverage": "docker-compose -f ../../infrastructure/docker-compose.test.yml run --rm dm-console-test npm run test:coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "socket.io-client": "^4.6.1",
    "vue": "^3.4.15",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "^1.2.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.2",
    "vue-tsc": "^2.0.0"
  }
}
